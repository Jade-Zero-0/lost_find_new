# ============================================================
# AI寻物宝 后端环境变量模板
# 部署到服务器时：把本文件复制为 .env（或直接注入环境变量），
# 至少配置 GLM_API_KEY，其余可用默认值。
# 注意：.env 已被 .gitignore 忽略，切勿提交到代码库/前端。
# ============================================================

# ---- AI 提供商 ----
# zhipu（真实视觉模型，默认推荐）| mock（离线模拟，断网可演示）
AI_PROVIDER=zhipu

# ---- 智谱 GLM 视觉模型（必填项）----
# 【必填】智谱开放平台 API Key（https://open.bigmodel.cn 创建）
# 仅后端读取 process.env.GLM_API_KEY；不配置时程序会明确提示「未配置 GLM_API_KEY」，
# 且不会把 Key 打印到任何日志。
GLM_API_KEY=

# ---- 智谱 GLM 视觉模型（可选项，均有默认值）----
# 主模型（免费）：glm-4.6v-flash；备用模型：glm-4.6v（高性能版，非免费）
GLM_MODEL=glm-4.6v-flash
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_FALLBACK_MODEL=glm-4.6v

# 主模型只尝试 1 次（0=不重试）；设为 1 可开启 429 退避重试（共 2 次）
GLM_MAX_RETRIES=0
GLM_RETRY_DELAY_MS=2000
# 单次请求超时（毫秒）：超时/失败即切备用模型
GLM_TIMEOUT_MS=8000

# 兼容旧变量：如使用旧版配置 ZHIPU_API_KEY / ZHIPU_MODEL / ZHIPU_BASE_URL / ZHIPU_FALLBACK_MODEL /
# ZHIPU_MAX_RETRIES / ZHIPU_RETRY_DELAY_MS / ZHIPU_TIMEOUT_MS 也仍生效（GLM_* 优先）。

# ---- DeepSeek V4（已停用，仅预留）----
# ⚠️ DeepSeek 官方 API 为纯文本模型，不支持图片输入（HTTP 400 InvalidParameter: image_url）。
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- 通用 ----
# 全局识别超时（毫秒，被 GLM_TIMEOUT_MS 覆盖时以 GLM_TIMEOUT_MS 为准）
AI_TIMEOUT_MS=8000
# 真实模型失败时是否用 mock 兜底（true=兜底保证演示不中断；false=禁用 mock，直接报错）
# 注意：限流(429)时永不降级 mock，直接返回「AI 识别请求过于频繁，请稍后重试」
AI_FALLBACK_TO_MOCK=false

# 服务端口（生产可改；Nginx 反代时一般仍用 3001）
PORT=3001

# ============================================================
# ---- 生产部署（均可选，有默认值）----
# ============================================================

# 监听地址：0.0.0.0 允许公网访问（仅本机调试可改为 127.0.0.1）
HOST=0.0.0.0

# CORS 允许的来源（逗号分隔；留空=允许所有来源，公网 Demo 默认）
# 例：CORS_ORIGIN=https://your-domain.com,https://www.your-domain.com
CORS_ORIGIN=

# 上传图片目录（留空= backend/uploads；生产建议挂载持久化磁盘，如 /data/ai-lost-found/uploads）
UPLOAD_DIR=

# 单张图片大小上限（MB，默认 8）
MAX_UPLOAD_MB=8

# JSON 请求体上限（默认 15mb，需大于图片 base64 体积）
JSON_BODY_LIMIT=15mb

# 是否生产模式（当前仅用于日志/提示，暂不影响功能）
NODE_ENV=production

# ---- 安全（公网分享/部署必看）----
# 演示账号 admin 的初始密码（默认 admin123；公网务必改成强密码）。
# 注意：仅用户表为空时生效；改后需删除 database/users.json 再重启。
ADMIN_INIT_PASSWORD=admin123

# 是否自动播种演示账号（userA/userB/admin）。公网部署可设 false 关闭，改用自己注册的账号。
SEED_DEMO_ACCOUNTS=true