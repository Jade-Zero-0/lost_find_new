# ============================================================
# AI寻物宝 前端构建环境变量（构建时由 Vite 注入）
# 生产部署时把本文件复制为 .env 并配置，然后重新执行 npm run build。
# 注意：.env 已被 .gitignore 忽略，切勿提交到代码库。
# ============================================================

# 后端 API 基础地址：
#   - 留空（默认）：同源访问，适合「后端托管前端 dist」的单服务部署
#   - 前后端分离时：填后端公网地址，例如 https://api.example.com（不要以 / 结尾）
VITE_API_BASE_URL=

# 前端请求超时（毫秒，默认 60000）
VITE_API_TIMEOUT_MS=60000

# 仅本地开发用：Vite 代理后端地址（默认 http://localhost:3001）
VITE_DEV_PROXY_TARGET=http://localhost:3001